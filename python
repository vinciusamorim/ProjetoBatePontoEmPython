from flask import Flask, render_template, request
import csv
from datetime import datetime

app = Flask(__name__)
DATA_FILE = 'data/registros.csv'

def registrar_ponto(funcionario_id):
    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    try:
        with open(DATA_FILE, 'a', newline='') as csvfile:
            writer = csv.writer(csvfile)
            writer.writerow([funcionario_id, now])
        return True
    except Exception as e:
        print(f"Erro ao registrar ponto: {e}")
        return False

@app.route('/', methods=['GET', 'POST'])
def index():
    mensagem = None
    if request.method == 'POST':
        funcionario_id = request.form.get('funcionario_id')
        if funcionario_id:
            if registrar_ponto(funcionario_id):
                mensagem = f"Ponto registrado com sucesso para o funcionário {funcionario_id} às {datetime.now().strftime('%H:%M:%S')}."
            else:
                mensagem = "Erro ao registrar o ponto."
        else:
            mensagem = "Por favor, insira o ID do funcionário."
    return render_template('index.html', mensagem=mensagem)

if __name__ == '__main__':
    # Criar a pasta 'data' e o arquivo CSV se não existirem
    import os
    if not os.path.exists('data'):
        os.makedirs('data')
    if not os.path.exists(DATA_FILE):
        with open(DATA_FILE, 'w', newline='') as csvfile:
            writer = csv.writer(csvfile)
            writer.writerow(['ID do Funcionário', 'Data e Hora'])

    app.run(debug=True)
